#!/usr/bin/env bash
set -euo pipefail

# CI only, called by `make ci-verify`. Brings up db + the pre-baked
# CI-only Ollama (docker/ollama-ci), then runs the containerized app
# service against them twice, asserting on the resulting database state
# directly each time — not just that the container exited 0. Confirms
# real rows land, and that re-running replaces them rather than
# duplicating them. Then brings up the containerized serve service and
# makes real /query and /chat calls against the real ingested data through
# the real (CI-sized) Ollama models, asserting on the results — the one
# tier of testing that needs live models, so it lives here rather than in
# `make test`. /chat uses qwen3:0.6b (baked into the CI Ollama image),
# not the qwen3:8b default — see docker/ollama-ci/Dockerfile for why.

POSTGRES_USER="${POSTGRES_USER:-rag}"
POSTGRES_DB="${POSTGRES_DB:-rag}"
SERVER_PORT="${SERVER_PORT:-8080}"

docker compose up -d --wait db ollama

# app/cmd-ingest no longer creates the schema itself (see internal/store's
# migrations) — apply it explicitly first, via the same containerized
# `migrate` service a local `docker compose run --rm migrate` would use, so
# CI exercises the same path as documented rather than a bespoke one.
docker compose run --rm migrate

sql_count() {
  docker compose exec -T db psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc "SELECT count(*) FROM $1;"
}

run_ingest() {
  # --exit-code-from makes `up`'s own exit status match app's, instead of
  # always returning 0 regardless of how the container actually exited.
  # OLLAMA_CHAT_MODEL=qwen3:0.6b so corpus-summary generation
  # (internal/chat.OllamaChat.Summarize) uses the CI-sized model too.
  OLLAMA_URL=http://ollama:11434 OLLAMA_CHAT_MODEL=qwen3:0.6b \
    docker compose up --build --exit-code-from app app
}

echo "== First ingestion run =="
run_ingest
docs1=$(sql_count documents)
chunks1=$(sql_count chunks)
echo "documents=$docs1 chunks=$chunks1"

if [ "$docs1" -eq 0 ] || [ "$chunks1" -eq 0 ]; then
  echo "FAIL: ingestion produced zero documents/chunks" >&2
  exit 1
fi

echo
echo "== Second ingestion run (idempotency check) =="
run_ingest
docs2=$(sql_count documents)
chunks2=$(sql_count chunks)
echo "documents=$docs2 chunks=$chunks2"

if [ "$docs2" -ne "$docs1" ] || [ "$chunks2" -ne "$chunks1" ]; then
  echo "FAIL: re-running ingestion changed row counts (documents $docs1 -> $docs2, chunks $chunks1 -> $chunks2) — should replace existing rows, not duplicate them" >&2
  exit 1
fi

echo
echo "OK: containerized ingestion produced $docs1 documents / $chunks1 chunks, stable across a re-run"

echo
echo "== Query API smoke test (serve + real Ollama) =="
OLLAMA_URL=http://ollama:11434 OLLAMA_CHAT_MODEL=qwen3:0.6b \
  docker compose up -d --build serve

# serve's image is distroless/static (no shell, no curl/wget inside the
# container to back a docker-compose healthcheck), so poll it from out here
# instead — same as how a real deploy's smoke test would probe a service
# from outside it.
for i in $(seq 1 30); do
  curl -fsS "http://localhost:$SERVER_PORT/healthz" >/dev/null 2>&1 && break
  sleep 1
done

response=$(curl -fsS -G "http://localhost:$SERVER_PORT/query" \
  --data-urlencode "query=how did Ulmarin develop technology without fire or metal?" \
  --data-urlencode "top_k=1")
echo "$response"

if ! echo "$response" | grep -q '"source":"04-ulmarin-technology.md"'; then
  echo "FAIL: expected the technology doc as the top match, got: $response" >&2
  exit 1
fi

echo
echo "OK: containerized query API returned the expected top match"

echo
echo "== Chat API smoke test (serve + real Ollama, qwen3:0.6b) =="

# qwen3:0.6b is small enough that whether it decides to call the tool on
# any single attempt is genuinely stochastic (no fixed temperature/seed)
# — local testing measured it calling retrieve_documents only ~50-60% of
# the time for this exact prompt, independent of the actual wiring being
# correct. It's also slow on GitHub's CPU-only runners: a full run
# (retrieve -> answer -> verify) can take a couple of minutes. This isn't
# a bug to fix in the app; it's the tradeoff of using a tiny CI-sized
# model at all (see docker/ollama-ci/Dockerfile). So the smoke test
# retries a few times — treating a timeout or a no-tool-call run as a
# retryable miss — and passes on the first attempt that calls the tool.
chat_ok=false
for attempt in $(seq 1 6); do
  echo "--- attempt $attempt ---"
  chat_response=$(curl -fsS --max-time 240 -X POST "http://localhost:$SERVER_PORT/chat" \
    -H "Content-Type: application/json" \
    -d '{"messages":[{"role":"user","content":"How did the Ulmarin develop technology without fire or metal? Use the retrieve_documents tool to find out."}]}' || true)
  echo "$chat_response"

  if ! echo "$chat_response" | grep -q 'event: done'; then
    echo "no completed stream on attempt $attempt (timeout or error); retrying"
    continue
  fi
  if echo "$chat_response" | grep -q 'event: tool_call'; then
    chat_ok=true
    break
  fi
  echo "no tool_call event on attempt $attempt; retrying"
done

if ! $chat_ok; then
  echo "FAIL: expected a completed stream with a tool_call event naming retrieve_documents in at least one of 6 attempts, got none" >&2
  exit 1
fi

echo
echo "OK: containerized chat API called retrieve_documents and completed the stream"

echo
echo "== Chat API lore_drop smoke test (serve + real Ollama, qwen3:0.6b) =="

# Same stochastic-tiny-model caveat as the retrieve_documents check above
# (a timeout or a no-tool-call run is a retryable miss). Passes on the
# first attempt that calls lore_drop AND lands a new row in the DB
# (proving the write + re-ingest round-tripped). The distroless serve
# image has no shell, so we assert on the DB from out here rather than
# exec-ing into the container. This run also exercises the tool-enabled
# verification pass, so it gets a longer per-attempt budget.
docs_before=$(sql_count documents)
lore_drop_name="99-ci-lore-drop-smoke.md"
lore_ok=false
for attempt in $(seq 1 6); do
  echo "--- lore_drop attempt $attempt ---"
  lore_response=$(curl -fsS --max-time 300 -X POST "http://localhost:$SERVER_PORT/chat" \
    -H "Content-Type: application/json" \
    -d "{\"messages\":[{\"role\":\"user\",\"content\":\"The corpus has nothing about Ulmarin lullabies. Use the lore_drop tool to create $lore_drop_name with a short section inventing some Ulmarin lullaby lore.\"}]}" || true)
  echo "$lore_response"

  if ! echo "$lore_response" | grep -q 'event: done'; then
    echo "no completed stream on attempt $attempt (timeout or error); retrying"
    continue
  fi
  if echo "$lore_response" | grep -q 'event: tool_call' && [ "$(sql_count documents)" -gt "$docs_before" ]; then
    lore_ok=true
    break
  fi
  echo "no lore_drop round-trip on attempt $attempt; retrying"
done

# Don't leave the invented doc in the working tree regardless of outcome.
git checkout -- lore_docs 2>/dev/null || true
rm -f "lore_docs/$lore_drop_name"

if ! $lore_ok; then
  echo "FAIL: expected lore_drop to add a document row in at least one of 6 attempts, got none" >&2
  exit 1
fi

echo
echo "OK: containerized chat API wrote new lore and re-ingested it"
