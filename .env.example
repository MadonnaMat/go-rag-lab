# Copy to .env. docker-compose reads this automatically for variable
# substitution; `make` targets source it for native `go run`/`go test`.

# --- Postgres ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432

# DATABASE_URL used by the Go app itself (internal/config). When running
# natively on the host against `docker compose up -d db`, use localhost:
DATABASE_URL=postgres://rag:rag@localhost:5432/rag?sslmode=disable
# When the app runs inside docker-compose instead, docker-compose.yml
# overrides this to postgres://rag:rag@db:5432/rag?sslmode=disable.

# Separate database for `make test`/`make test-unit`, so test runs never
# share state with real ingested documents in DATABASE_URL's database.
# Created automatically by docker/initdb/01-create-test-db.sql the first
# time the db container's volume initializes.
TEST_DATABASE_URL=postgres://rag:rag@localhost:5432/rag_test?sslmode=disable

# --- Embeddings (see internal/embedding, scripts/ollama-dev) ---
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_URL=http://localhost:11434
# When the app runs inside docker-compose instead, docker-compose.yml
# overrides this to http://host.docker.internal:11434 (host-installed
# Ollama, reached from inside the container).

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
